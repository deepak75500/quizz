{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "quizz",
  "main": "main.py",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["python_workers"],

  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
